# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Automatic server-side Email & SMS delivery for Demo Requests
OWNER_EMAIL="jonathan.tadanki@gmail.com"
OWNER_SMS_PHONE="+919133661933"
# Resend Email API (https://resend.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ARSHIEL SAFETY <onboarding@resend.dev>"
# Twilio Normal SMS API (https://www.twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Alternative India Normal SMS Gateway (https://www.fast2sms.com)
FAST2SMS_API_KEY=""
# Optional Webhook Relay (Zapier / Make / n8n)
DEMO_ALERT_WEBHOOK_URL=""

# Optional: Discord Administrator Alerts Webhook (https://discord.com)
DISCORD_WEBHOOK_URL=""

# Optional: Supabase Storage (Backend Service Role ONLY — NEVER expose to frontend)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="arshiel-ehs-documents"

# Optional: HMAC secret for time-limited signed private document URLs (auto-derived if omitted)
DOCUMENT_SIGNING_SECRET=""


